#!/bin/bash
exec "$HOME/.local/share/junest/bin/junest" proot \
    -b "--bind /sgoinfre /sgoinfre --bind /goinfre /goinfre --bind /opt /opt --bind /usr /host/usr" \
    -- env \
    DISPLAY="${DISPLAY:-:0}" \
    XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" \
    VK_DRIVER_FILES="/usr/share/vulkan/icd.d/radeon_icd.json:/usr/share/vulkan/icd.d/intel_icd.json" \
    "$@"
