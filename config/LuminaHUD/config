# LuminaHUD — un HUD par fond d'écran de ~/Pictures/Wallpapers, pour un écran 1920x1080.
#
# Le thème suit LUMINA_THEME (1 casque, 2 lune, 3 néon), l'index du rice awesome :
# le HUD est lancé par ~/.config/LuminaHUD/start.sh. Sans variable, c'est le thème 1.
# Les données viennent de scripts/hud.py (météo, ISS, lancements, crypto, 42).
#
# Pas de panneaux : le texte est posé dans l'image, avec un halo (GlowColor / GlowSize)
# aux couleurs de la scène pour rester lisible.

[Settings]
Monitor=primary

# 1 · casque : blanc et jaune de la veste, halo du liseré bleu de la combinaison, encre sur le blanc
[Theme_casque]
text=E6E8F5FF
sub=9AA0C4FF
accent=F5D51EFF
halo=5B5BFFB0
halo_accent=F5D51E40
shade=05061299
ink=1D2244E6
ink_sub=4A5080E6
ink_title=4A44C8FF
ink_track=1D224430
track=FFFFFF22
clear=00000000
# (clés du thème néon : chaque clé utilisée par un bloc doit exister dans le thème de base)
accent2=7FE3C4FF
core=E6E8F5FF
halo2=7FE3C490
tear=D8F2FFF0
tear_shade=2A3470A0

# 2 · lune : lumière de la baie sur les murs, or des confettis
[Theme_lune]
When=env.LUMINA_THEME == 2
text=E9E6EED8
sub=A39DAED0
accent=E9B949F0
halo=FFFFFF30
halo_accent=E9B94930
shade=15131899
track=FFFFFF20
clear=00000000

# 3 · néon : tubes roses et cyan, ombre bleu nuit
[Theme_neon]
When=env.LUMINA_THEME == 3
text=E4E0FFFF
sub=B4ACE6FF
accent=FF9CF2FF
accent2=A8ECFFFF
core=FFE6FCFF
halo=E06CFFD0
halo_accent=E06CFF90
halo2=5FD0FF90
shade=0C0A22C0
